Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_php.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 32M
    php_value max_input_time 120
    php_value max_execution_time 120
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve the storefront from raw IP hosts.
    RewriteCond %{HTTP_HOST} ^(?:\d{1,3}\.){3}\d{1,3}$ [OR]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?34\.2\.139\.141$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?35\.187\.228\.206$ [NC]
    RewriteRule ^ https://nova-markets.org%{REQUEST_URI} [R=301,L]

    # Reject common exploit and traversal probes instead of rendering the app shell.
    RewriteCond %{THE_REQUEST} \s/+cgi-bin/ [NC,OR]
    RewriteCond %{REQUEST_URI} (^|/)(?:vendor|phpunit|xmlrpc|wp-config|phpinfo|info|test|adminer)\.php$ [NC,OR]
    RewriteCond %{QUERY_STRING} (?:allow_url_include|auto_prepend_file|php://|data://|expect://|pearcmd|think(?:\\|%5C)app|call_user_func_array|/bin/sh|\.\./|%2e%2e) [NC]
    RewriteRule ^ - [F,L]

    # Route storefront-only static pages through a PHP guard first.
    RewriteRule ^product\.html$ /storefront-page.php?page=product.html [L,QSA]
    RewriteRule ^cart\.html$ /storefront-page.php?page=cart.html [L,QSA]

    # Keep the homepage canonical at `/` instead of `/index.html`.
    RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self' https://nova-markets.org https://www.nova-markets.org https://checkout.stripe.com; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https://storage.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' ws: wss: https://cdn.jsdelivr.net; media-src 'self' https://storage.googleapis.com"
</IfModule>
